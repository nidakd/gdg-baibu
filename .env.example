# İletişim formu (src/lib/contact.ts). Resend hesabı gdgoncampusaibu@gmail.com ile açılmalı;
# kendi alan adı olmadan Resend sadece hesabın kendi adresine e-posta gönderebiliyor.
RESEND_API_KEY=
# İsteğe bağlı, alan adı doğrulanınca: CONTACT_FROM="GDG on Campus AİBÜ <iletisim@alanadi>"
CONTACT_FROM=

# Supabase (ekip verisi ve yönetim paneli). Yayınlanabilir anahtar gizli değil; yetkiler RLS ile korunur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# İsteğe bağlı: panelde site ziyaretleri (Vercel → Account Settings → Tokens, salt okunur)
VERCEL_ANALYTICS_TOKEN=
