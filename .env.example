# İletişim formu (src/lib/contact.ts). Resend hesabı gdgoncampusaibu@gmail.com ile açılmalı;
# kendi alan adı olmadan Resend sadece hesabın kendi adresine e-posta gönderebiliyor.
RESEND_API_KEY=
# İsteğe bağlı, alan adı doğrulanınca: CONTACT_FROM="GDG on Campus AİBÜ <iletisim@alanadi>"
CONTACT_FROM=

# Supabase (ekip verisi ve yönetim paneli). Yayınlanabilir anahtar gizli değil; yetkiler RLS ile korunur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sadece sunucu: form kayıtlarını yazar, başvuru onayını işaretler (RLS'i aşar; asla NEXT_PUBLIC_ olmasın).
# Supabase → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=

# Başvuru onay e-postası kulüp Gmail'inden (SMTP). Google hesabı → Güvenlik → 2 Adımlı Doğrulama →
# Uygulama şifreleri. İkisi ve SUPABASE_SECRET_KEY varsa onay açılır; yoksa başvurular onaysız gelir.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# İsteğe bağlı: panelde site ziyaretleri (Vercel → Account Settings → Tokens, salt okunur)
VERCEL_ANALYTICS_TOKEN=
